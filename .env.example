# Copy this file to `.env` (same folder) and fill in your own key:
#     cp .env.example .env
# `.env` is listed in .gitignore and must never be committed.

# Required: OpenAI API key (used for GPT-4o via ROSA and for Whisper speech-to-text).
OPENAI_API_KEY="sk-replace-me"

# Optional: override the chat model used by ROSA (default: gpt-4o).
# UR3_VOICE_LLM_MODEL="gpt-4o"
